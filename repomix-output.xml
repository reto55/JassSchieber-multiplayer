    def last_sent_of_type(self, t: str) -> dict | None:
        return next((m for m in reversed(self.sent) if m.get("type") == t), None)

    def all_sent_of_type(self, t: str) -> list[dict]:
        return [m for m in self.sent if m.get("type") == t]


