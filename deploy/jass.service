[Unit]
Description=JassSchieber-multiplayer FastAPI Backend
After=network.target

[Service]
# User and group that the application should run as.
# 'reto' is your current user. Change to a dedicated service user if desired.
User=reto
Group=reto

# The working directory where the project is located.
WorkingDirectory=/home/reto/Dokumente/JassSchieber-multiplayer

# Start Uvicorn pointing to the FastAPI app.
# By default, we run on 127.0.0.1:8000 so it is not exposed publicly,
# only the Apache proxy can access it.
ExecStart=/home/reto/Dokumente/JassSchieber-multiplayer/.venv/bin/uvicorn ausbau.server:app --host 127.0.0.1 --port 8000
# Note: If you're not using a virtual environment in .venv, change the path above to just `uvicorn`
# or the absolute path to your global uvicorn installation.

Restart=always
RestartSec=5
# Optional: point to an environment file if you need secrets (like SECRET_KEY)
# EnvironmentFile=/home/reto/Dokumente/JassSchieber-multiplayer/.env

[Install]
WantedBy=multi-user.target
